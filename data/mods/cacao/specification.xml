<!-- Cacao (farmed, tropical) → chocolate (export, or spent locally in the
     creole salon for bells). -->
<freecol-specification id="cacao" version="0.3">
  <goods-types>
    <goods-type id="model.goods.cacao" is-farmed="true"
                new-world-goods="true" production-weight="2.5">
      <market initial-amount="1500" initial-price="2" price-difference="2"/>
    </goods-type>
    <goods-type id="model.goods.chocolate" is-farmed="false"
                made-from="model.goods.cacao" new-world-goods="true"
                production-weight="2.0">
      <market initial-amount="800" initial-price="11" price-difference="2"/>
    </goods-type>
  </goods-types>

  <resource-types>
    <resource-type id="model.resource.cacao">
      <modifier id="model.goods.cacao" index="10"
                type="multiplicative" value="2"/>
    </resource-type>
  </resource-types>

  <tile-types>
    <tile-type id="model.tile.savannah" preserve="true">
      <production>
        <output goods-type="model.goods.cacao" value="3"/>
      </production>
      <resource type="model.resource.cacao" probability="40"/>
    </tile-type>
    <tile-type id="model.tile.tropicalForest" preserve="true">
      <production>
        <output goods-type="model.goods.cacao" value="2"/>
      </production>
      <resource type="model.resource.cacao" probability="50"/>
    </tile-type>
    <tile-type id="model.tile.scrubForest" preserve="true">
      <production>
        <output goods-type="model.goods.cacao" value="2"/>
      </production>
      <resource type="model.resource.cacao" probability="30"/>
    </tile-type>
    <tile-type id="model.tile.plains" preserve="true">
      <production>
        <output goods-type="model.goods.cacao" value="1"/>
      </production>
    </tile-type>
  </tile-types>

  <unit-types>
    <unit-type id="model.unit.expertCacaoPlanter" extends="colonist"
               skill="2" expert-production="model.goods.cacao"
               score-value="5">
      <modifier id="model.goods.cacao" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.masterChocolatier" extends="colonist"
               price="1100" skill="2" expert-production="model.goods.chocolate"
               recruit-probability="1" score-value="5">
      <modifier id="model.goods.chocolate" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <!-- Native expert, only reachable with the conversos mod. -->
    <unit-type id="model.unit.nativeCacaoPlanter" extends="model.unit.indianConvert"
               expert-production="model.goods.cacao" score-value="4"
               maximum-experience="0">
      <ability id="model.ability.nativeConvert" value="true"/>
      <modifier id="model.goods.cacao" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
  </unit-types>

  <unit-change-types>
    <unit-change-type id="model.unitChange.clearSkill" preserve="true">
      <unit-type-change id="model.unitChange.clearSkill.expertCacaoPlanter"
                        from="model.unit.expertCacaoPlanter"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.masterChocolatier"
                        from="model.unit.masterChocolatier"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeCacaoPlanter"
                        from="model.unit.nativeCacaoPlanter"
                        to="model.unit.indianConvert" probability="100"/>
    </unit-change-type>
    <unit-change-type id="model.unitChange.education" preserve="true">
      <unit-type-change id="model.unitChange.education.expertCacaoPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertCacaoPlanter"
                        probability="100" turns="6"/>
      <unit-type-change id="model.unitChange.education.masterChocolatier"
                        from="model.unit.freeColonist"
                        to="model.unit.masterChocolatier"
                        probability="100" turns="6"/>
    </unit-change-type>
    <unit-change-type id="model.unitChange.experience" preserve="true">
      <unit-type-change id="model.unitChange.experience.expertCacaoPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertCacaoPlanter" probability="4"/>
      <unit-type-change id="model.unitChange.experience.masterChocolatier"
                        from="model.unit.freeColonist"
                        to="model.unit.masterChocolatier" probability="4"/>
      <unit-type-change id="model.unitChange.experience.nativeCacaoPlanter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeCacaoPlanter" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
    </unit-change-type>
    <unit-change-type id="model.unitChange.natives" preserve="true">
      <unit-type-change id="model.unitChange.natives.indenturedServant-expertCacaoPlanter"
                        from="model.unit.indenturedServant"
                        to="model.unit.expertCacaoPlanter" probability="100"/>
      <unit-type-change id="model.unitChange.natives.freeColonist-expertCacaoPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertCacaoPlanter" probability="100"/>
    </unit-change-type>
  </unit-change-types>

  <building-types>
    <building-type id="model.building.chocolatierHouse">
      <production>
        <input goods-type="model.goods.cacao" value="3"/>
        <output goods-type="model.goods.chocolate" value="3"/>
      </production>
      <required-goods id="model.goods.hammers" value="32"/>
    </building-type>
    <building-type id="model.building.chocolatierShop"
                   extends="model.building.chocolatierHouse"
                   upgrades-from="model.building.chocolatierHouse"
                   competence-factor="2"
                   upkeep="5">
      <production>
        <input goods-type="model.goods.cacao" value="6"/>
        <output goods-type="model.goods.chocolate" value="6"/>
      </production>
      <required-goods id="model.goods.hammers" value="64"/>
      <required-goods id="model.goods.tools" value="20"/>
    </building-type>
    <building-type id="model.building.chocolateFactory"
                   extends="model.building.chocolatierShop"
                   upgrades-from="model.building.chocolatierShop"
                   experts-with-connections-production="4"
                   competence-factor="3" rebel-factor="1.5"
                   required-population="8" upkeep="15">
      <production>
        <input goods-type="model.goods.cacao" value="6"/>
        <output goods-type="model.goods.chocolate" value="9"/>
      </production>
      <required-goods id="model.goods.hammers" value="160"/>
      <required-goods id="model.goods.tools" value="100"/>
      <required-ability id="model.ability.buildFactory"/>
      <ability id="model.ability.expertsUseConnections" value="true"/>
    </building-type>
    <building-type id="model.building.creoleSalon" workplaces="0"
                   required-population="3">
      <production unattended="true">
        <input goods-type="model.goods.chocolate" value="3"/>
        <output goods-type="model.goods.bells" value="2"/>
      </production>
      <required-goods id="model.goods.hammers" value="64"/>
      <ability id="model.ability.rebelBonusUnattended"/>
    </building-type>
  </building-types>

  <indian-nation-types>
    <indian-nation-type id="model.nationType.aztec" preserve="true">
      <skill id="model.unit.expertCacaoPlanter" probability="15"/>
    </indian-nation-type>
    <indian-nation-type id="model.nationType.inca" preserve="true">
      <skill id="model.unit.expertCacaoPlanter" probability="10"/>
    </indian-nation-type>
    <indian-nation-type id="model.nationType.tupi" preserve="true">
      <skill id="model.unit.expertCacaoPlanter" probability="10"/>
    </indian-nation-type>
  </indian-nation-types>
</freecol-specification>
