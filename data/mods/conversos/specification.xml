<!--
    Converts: with Bartolome de las Casas in the Congress, Indian converts
    gain experience in outdoor work (native field experts) and in guild
    crafts (native apprentices, ceiling). They stay converts in every other
    respect: they cannot found colonies, are poor at indoor work and cannot
    teach (skill 0). The one-time conversion of all converts into free
    colonists is removed. European apprentice ladders belong in Apprentices.
  -->
<freecol-specification id="conversos" version="0.1">
  <unit-change-types>
    <!-- Empty redefinition: Las Casas no longer turns converts into
         free colonists. -->
    <unit-change-type id="model.unitChange.foundingFather"/>
    <unit-change-type id="model.unitChange.experience" preserve="true">
      <unit-type-change id="model.unitChange.experience.nativeExpertFarmer"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertFarmer" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeExpertFisherman"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertFisherman" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeExpertFurTrapper"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertFurTrapper" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeExpertSilverMiner"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertSilverMiner" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeExpertLumberJack"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertLumberJack" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeExpertOreMiner"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeExpertOreMiner" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeMasterSugarPlanter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeMasterSugarPlanter" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeMasterCottonPlanter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeMasterCottonPlanter" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeMasterTobaccoPlanter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeMasterTobaccoPlanter" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>

      <!-- Guild crafts: ceiling at native apprentice (Las Casas). -->
      <unit-type-change id="model.unitChange.experience.nativeApprenticeCarpenter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeCarpenter" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeDistiller"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeDistiller" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeWeaver"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeWeaver" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeTobacconist"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeTobacconist" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeFurTrader"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeFurTrader" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeBlacksmith"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeBlacksmith" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.experience.nativeApprenticeGunsmith"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeGunsmith" probability="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
    </unit-change-type>

    <!-- School to native guild apprentice after Las Casas (append; load
         Apprentices before this mod so education is not wiped later). -->
    <unit-change-type id="model.unitChange.education" preserve="true">
      <unit-type-change id="model.unitChange.education.nativeApprenticeCarpenter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeCarpenter"
                        probability="100" turns="3">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeDistiller"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeDistiller"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeWeaver"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeWeaver"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeTobacconist"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeTobacconist"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeFurTrader"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeFurTrader"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeBlacksmith"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeBlacksmith"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
      <unit-type-change id="model.unitChange.education.nativeApprenticeGunsmith"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeApprenticeGunsmith"
                        probability="100" turns="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
    </unit-change-type>

    <unit-change-type id="model.unitChange.clearSkill" preserve="true">
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertFarmer"
                        from="model.unit.nativeExpertFarmer"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertFisherman"
                        from="model.unit.nativeExpertFisherman"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertFurTrapper"
                        from="model.unit.nativeExpertFurTrapper"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertSilverMiner"
                        from="model.unit.nativeExpertSilverMiner"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertLumberJack"
                        from="model.unit.nativeExpertLumberJack"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeExpertOreMiner"
                        from="model.unit.nativeExpertOreMiner"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeMasterSugarPlanter"
                        from="model.unit.nativeMasterSugarPlanter"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeMasterCottonPlanter"
                        from="model.unit.nativeMasterCottonPlanter"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeMasterTobaccoPlanter"
                        from="model.unit.nativeMasterTobaccoPlanter"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeCarpenter"
                        from="model.unit.nativeApprenticeCarpenter"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeDistiller"
                        from="model.unit.nativeApprenticeDistiller"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeWeaver"
                        from="model.unit.nativeApprenticeWeaver"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeTobacconist"
                        from="model.unit.nativeApprenticeTobacconist"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeFurTrader"
                        from="model.unit.nativeApprenticeFurTrader"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeBlacksmith"
                        from="model.unit.nativeApprenticeBlacksmith"
                        to="model.unit.indianConvert" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeApprenticeGunsmith"
                        from="model.unit.nativeApprenticeGunsmith"
                        to="model.unit.indianConvert" probability="100"/>
    </unit-change-type>
  </unit-change-types>

  <unit-types>
    <!-- Full redefinition, maximum-experience is an attribute. -->
    <unit-type id="model.unit.indianConvert"
               skill="0" offence="0" defence="1" movement="3" line-of-sight="1"
               maximum-attrition="8" score-value="3" hit-points="5"
               maximum-experience="200">
      <consumes id="model.goods.food" value="2"/>
      <consumes id="model.goods.bells" value="1"/>
      <ability id="model.ability.person"
               value="true"/>
      <ability id="model.ability.foundColony"
               value="false"/>
      <ability id="model.ability.nativeConvert"
               value="true"/>
      <modifier id="model.goods.grain"   index="30" type="additive" value="1"/>
      <modifier id="model.goods.sugar"   index="30" type="additive" value="1"/>
      <modifier id="model.goods.tobacco" index="30" type="additive" value="1"/>
      <modifier id="model.goods.cotton"  index="30" type="additive" value="1"/>
      <modifier id="model.goods.furs"    index="30" type="additive" value="1"/>
      <modifier id="model.goods.fish"    index="30" type="additive" value="1"/>
      <modifier id="model.goods.rum"     index="30" type="additive" value="-2"/>
      <modifier id="model.goods.cigars"  index="30" type="additive" value="-2"/>
      <modifier id="model.goods.cloth"   index="30" type="additive" value="-2"/>
      <modifier id="model.goods.coats"   index="30" type="additive" value="-2"/>
      <modifier id="model.goods.muskets" index="30" type="additive" value="-2"/>
      <modifier id="model.goods.bells"   index="30" type="additive" value="-2"/>
      <modifier id="model.goods.crosses" index="30" type="additive" value="-2"/>
      <modifier id="model.goods.hammers" index="30" type="additive" value="-2"/>
      <modifier id="model.goods.tools"   index="30" type="additive" value="-2"/>
    </unit-type>

    <!-- Native experts keep the convert's bonuses and penalties and add
         the matching European expert's bonus on top. -->
    <unit-type id="model.unit.nativeExpertFarmer" extends="model.unit.indianConvert"
               expert-production="model.goods.grain" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.grain" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeExpertFisherman" extends="model.unit.indianConvert"
               expert-production="model.goods.fish" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.fish" index="30" type="additive" value="3"/>
    </unit-type>
    <unit-type id="model.unit.nativeExpertFurTrapper" extends="model.unit.indianConvert"
               expert-production="model.goods.furs" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.furs" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeExpertSilverMiner" extends="model.unit.indianConvert"
               expert-production="model.goods.silver" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.silver" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeExpertLumberJack" extends="model.unit.indianConvert"
               expert-production="model.goods.lumber" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.lumber" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeExpertOreMiner" extends="model.unit.indianConvert"
               expert-production="model.goods.ore" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.ore" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeMasterSugarPlanter" extends="model.unit.indianConvert"
               expert-production="model.goods.sugar" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.sugar" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeMasterCottonPlanter" extends="model.unit.indianConvert"
               expert-production="model.goods.cotton" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.cotton" index="30" type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeMasterTobaccoPlanter" extends="model.unit.indianConvert"
               expert-production="model.goods.tobacco" score-value="4"
               maximum-experience="0">
      <modifier id="model.goods.tobacco" index="30" type="multiplicative" value="2"/>
    </unit-type>

    <!-- Native guild apprentices: ceiling below European master. -->
    <unit-type id="model.unit.nativeApprenticeCarpenter" extends="model.unit.indianConvert"
               expert-production="model.goods.hammers" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.hammers" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeDistiller" extends="model.unit.indianConvert"
               expert-production="model.goods.rum" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.rum" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeWeaver" extends="model.unit.indianConvert"
               expert-production="model.goods.cloth" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.cloth" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeTobacconist" extends="model.unit.indianConvert"
               expert-production="model.goods.cigars" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.cigars" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeFurTrader" extends="model.unit.indianConvert"
               expert-production="model.goods.coats" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.coats" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeBlacksmith" extends="model.unit.indianConvert"
               expert-production="model.goods.tools" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.tools" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.nativeApprenticeGunsmith" extends="model.unit.indianConvert"
               expert-production="model.goods.muskets" score-value="3"
               maximum-experience="0">
      <modifier id="model.goods.muskets" index="30" type="additive" value="2"/>
    </unit-type>
  </unit-types>
</freecol-specification>
