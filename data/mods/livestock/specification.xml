<!--
    Europe livestock bootstrap + colonial processing:
      cows (breed) → dairy (cows→milk) → cheese house (milk→cheese)
                   → brotherhood hall (cheese→crosses)
      sheep (breed) → wool shed (sheep→wool) → weaver (wool→cloth)
    Dairy and wool shed take 1 animal per 3 output, so the herd size and
    the pen's breeding rate cap how much milk and wool a colony can make.
  -->
<freecol-specification id="livestock" version="0.5">
  <goods-types>
    <goods-type id="model.goods.cows" is-farmed="false"
                breeding-number="2" made-from="model.goods.food">
      <market initial-amount="2000" initial-price="2" price-difference="2"/>
    </goods-type>
    <goods-type id="model.goods.sheep" is-farmed="false"
                breeding-number="2" made-from="model.goods.food">
      <market initial-amount="2000" initial-price="2" price-difference="2"/>
    </goods-type>
    <goods-type id="model.goods.milk" is-farmed="false"
                perishable="true" production-weight="2.5">
      <market initial-amount="1200" initial-price="3" price-difference="2"/>
    </goods-type>
    <goods-type id="model.goods.wool" is-farmed="false"
                production-weight="2.5">
      <market initial-amount="1200" initial-price="3" price-difference="2"/>
    </goods-type>
    <goods-type id="model.goods.cheese" is-farmed="false"
                made-from="model.goods.milk" new-world-goods="false"
                production-weight="2.0">
      <market initial-amount="800" initial-price="9" price-difference="2"/>
    </goods-type>
  </goods-types>

  <unit-types>
    <unit-type id="model.unit.expertDairyWorker" extends="colonist"
               price="900" skill="1" expert-production="model.goods.milk"
               recruit-probability="1" score-value="4">
      <modifier id="model.goods.milk" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.expertShepherd" extends="colonist"
               price="900" skill="1" expert-production="model.goods.wool"
               recruit-probability="1" score-value="4">
      <modifier id="model.goods.wool" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <unit-type id="model.unit.masterCheesemaker" extends="colonist"
               price="1100" skill="2" expert-production="model.goods.cheese"
               recruit-probability="1" score-value="5">
      <modifier id="model.goods.cheese" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <!-- New World only. Two-step path, same timing as Apprentices. -->
    <unit-type id="model.unit.apprenticeDairyWorker" extends="model.unit.freeColonist"
               recruit-probability="0" skill="0" expert-production="model.goods.milk"
               score-value="3" maximum-experience="200">
      <modifier id="model.goods.milk" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.apprenticeShepherd" extends="model.unit.freeColonist"
               recruit-probability="0" skill="0" expert-production="model.goods.wool"
               score-value="3" maximum-experience="200">
      <modifier id="model.goods.wool" index="30" type="additive" value="2"/>
    </unit-type>
    <unit-type id="model.unit.apprenticeCheesemaker" extends="model.unit.freeColonist"
               recruit-probability="0" skill="0" expert-production="model.goods.cheese"
               score-value="3" maximum-experience="200">
      <modifier id="model.goods.cheese" index="30" type="additive" value="2"/>
    </unit-type>
  </unit-types>

  <unit-change-types>
    <unit-change-type id="model.unitChange.clearSkill" preserve="true">
      <unit-type-change id="model.unitChange.clearSkill.expertDairyWorker"
                        from="model.unit.expertDairyWorker"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.expertShepherd"
                        from="model.unit.expertShepherd"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.masterCheesemaker"
                        from="model.unit.masterCheesemaker"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.apprenticeDairyWorker"
                        from="model.unit.apprenticeDairyWorker"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.apprenticeShepherd"
                        from="model.unit.apprenticeShepherd"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.apprenticeCheesemaker"
                        from="model.unit.apprenticeCheesemaker"
                        to="model.unit.freeColonist" probability="100"/>
    </unit-change-type>
    <!-- Append. Load after Apprentices, which replaces these tables.
         Skill 1: school 2+3, experience 6 then 3. Skill 2: 3+4 and 4 then 2. -->
    <unit-change-type id="model.unitChange.education" preserve="true">
      <unit-type-change id="model.unitChange.education.apprenticeDairyWorker"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeDairyWorker"
                        probability="100" turns="2"/>
      <unit-type-change id="model.unitChange.education.apprenticeShepherd"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeShepherd"
                        probability="100" turns="2"/>
      <unit-type-change id="model.unitChange.education.apprenticeCheesemaker"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeCheesemaker"
                        probability="100" turns="3"/>
      <unit-type-change id="model.unitChange.education.expertDairyWorker"
                        from="model.unit.apprenticeDairyWorker"
                        to="model.unit.expertDairyWorker"
                        probability="100" turns="3"/>
      <unit-type-change id="model.unitChange.education.expertShepherd"
                        from="model.unit.apprenticeShepherd"
                        to="model.unit.expertShepherd"
                        probability="100" turns="3"/>
      <unit-type-change id="model.unitChange.education.masterCheesemaker"
                        from="model.unit.apprenticeCheesemaker"
                        to="model.unit.masterCheesemaker"
                        probability="100" turns="4"/>
    </unit-change-type>
    <unit-change-type id="model.unitChange.experience" preserve="true">
      <unit-type-change id="model.unitChange.experience.apprenticeDairyWorker"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeDairyWorker" probability="6"/>
      <unit-type-change id="model.unitChange.experience.apprenticeShepherd"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeShepherd" probability="6"/>
      <unit-type-change id="model.unitChange.experience.apprenticeCheesemaker"
                        from="model.unit.freeColonist"
                        to="model.unit.apprenticeCheesemaker" probability="4"/>
      <unit-type-change id="model.unitChange.experience.expertDairyWorker"
                        from="model.unit.apprenticeDairyWorker"
                        to="model.unit.expertDairyWorker" probability="3"/>
      <unit-type-change id="model.unitChange.experience.expertShepherd"
                        from="model.unit.apprenticeShepherd"
                        to="model.unit.expertShepherd" probability="3"/>
      <unit-type-change id="model.unitChange.experience.masterCheesemaker"
                        from="model.unit.apprenticeCheesemaker"
                        to="model.unit.masterCheesemaker" probability="2"/>
    </unit-change-type>
  </unit-change-types>

  <building-types>
    <!-- Breeding: buildable (not free like country pasture for horses) -->
    <building-type id="model.building.cattlePen"
                   workplaces="0" priority="700">
      <production unattended="true">
        <input goods-type="model.goods.food" value="1"/>
        <output goods-type="model.goods.cows" value="1"/>
      </production>
      <required-goods id="model.goods.hammers" value="32"/>
      <ability id="model.ability.autoProduction"/>
      <ability id="model.ability.avoidExcessProduction"/>
      <modifier id="model.modifier.breedingDivisor" index="60"
                type="additive" value="50"/>
      <modifier id="model.modifier.breedingFactor" index="60"
                type="additive" value="2"/>
      <modifier id="model.goods.cows" index="60"
                type="multiplicative" value="1.0"/>
      <modifier id="model.modifier.consumeOnlySurplusProduction" index="60"
                type="multiplicative" value="0.5"/>
    </building-type>

    <building-type id="model.building.sheepfold"
                   workplaces="0" priority="700">
      <production unattended="true">
        <input goods-type="model.goods.food" value="1"/>
        <output goods-type="model.goods.sheep" value="1"/>
      </production>
      <required-goods id="model.goods.hammers" value="32"/>
      <ability id="model.ability.autoProduction"/>
      <ability id="model.ability.avoidExcessProduction"/>
      <modifier id="model.modifier.breedingDivisor" index="60"
                type="additive" value="50"/>
      <modifier id="model.modifier.breedingFactor" index="60"
                type="additive" value="2"/>
      <modifier id="model.goods.sheep" index="60"
                type="multiplicative" value="1.0"/>
      <modifier id="model.modifier.consumeOnlySurplusProduction" index="60"
                type="multiplicative" value="0.5"/>
    </building-type>

    <!-- Processing -->
    <building-type id="model.building.dairy">
      <production>
        <input goods-type="model.goods.cows" value="1"/>
        <output goods-type="model.goods.milk" value="3"/>
      </production>
      <required-goods id="model.goods.hammers" value="32"/>
    </building-type>

    <building-type id="model.building.woolShed">
      <production>
        <input goods-type="model.goods.sheep" value="1"/>
        <output goods-type="model.goods.wool" value="3"/>
      </production>
      <required-goods id="model.goods.hammers" value="32"/>
    </building-type>

    <building-type id="model.building.cheeseHouse">
      <production>
        <input goods-type="model.goods.milk" value="3"/>
        <output goods-type="model.goods.cheese" value="3"/>
      </production>
      <required-goods id="model.goods.hammers" value="52"/>
    </building-type>
    <building-type id="model.building.cheeseShop"
                   extends="model.building.cheeseHouse"
                   upgrades-from="model.building.cheeseHouse"
                   competence-factor="2"
                   upkeep="5">
      <production>
        <input goods-type="model.goods.milk" value="6"/>
        <output goods-type="model.goods.cheese" value="6"/>
      </production>
      <required-goods id="model.goods.hammers" value="64"/>
      <required-goods id="model.goods.tools" value="20"/>
    </building-type>

    <!-- Patron-saint feasts: spend cheese locally for crosses -->
    <building-type id="model.building.brotherhoodHall" workplaces="0"
                   required-population="3">
      <production unattended="true">
        <input goods-type="model.goods.cheese" value="2"/>
        <output goods-type="model.goods.crosses" value="1"/>
      </production>
      <required-goods id="model.goods.hammers" value="48"/>
      <ability id="model.ability.rebelBonusUnattended"/>
    </building-type>

    <!-- Weaver: cotton→cloth OR wool→cloth -->
    <building-type id="model.building.weaverHouse">
      <production>
        <input goods-type="model.goods.cotton" value="3"/>
        <output goods-type="model.goods.cloth" value="3"/>
      </production>
      <production>
        <input goods-type="model.goods.wool" value="3"/>
        <output goods-type="model.goods.cloth" value="3"/>
      </production>
    </building-type>
    <building-type id="model.building.weaverShop"
                   extends="model.building.weaverHouse"
                   upgrades-from="model.building.weaverHouse"
                   competence-factor="2"
                   upkeep="5">
      <production>
        <input goods-type="model.goods.cotton" value="6"/>
        <output goods-type="model.goods.cloth" value="6"/>
      </production>
      <production>
        <input goods-type="model.goods.wool" value="6"/>
        <output goods-type="model.goods.cloth" value="6"/>
      </production>
      <required-goods id="model.goods.hammers" value="64"/>
      <required-goods id="model.goods.tools" value="20"/>
    </building-type>
    <building-type id="model.building.textileMill"
                   extends="model.building.weaverShop"
                   upgrades-from="model.building.weaverShop"
                   experts-with-connections-production="4"
                   competence-factor="3" rebel-factor="1.5"
                   required-population="8" upkeep="15">
      <production>
        <input goods-type="model.goods.cotton" value="6"/>
        <output goods-type="model.goods.cloth" value="9"/>
      </production>
      <production>
        <input goods-type="model.goods.wool" value="6"/>
        <output goods-type="model.goods.cloth" value="9"/>
      </production>
      <required-goods id="model.goods.hammers" value="160"/>
      <required-goods id="model.goods.tools" value="100"/>
      <required-ability id="model.ability.buildFactory"/>
      <ability id="model.ability.expertsUseConnections" value="true"/>
    </building-type>
  </building-types>
</freecol-specification>
