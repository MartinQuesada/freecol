<!-- Tavern: spend rum locally for bells instead of exporting it. -->
<freecol-specification id="tabernas" version="0.2">
  <building-types>
    <building-type id="model.building.tavern" workplaces="0">
      <production unattended="true">
        <input goods-type="model.goods.rum" value="2"/>
        <output goods-type="model.goods.bells" value="1"/>
      </production>
      <required-goods id="model.goods.hammers" value="40"/>
      <ability id="model.ability.rebelBonusUnattended"/>
    </building-type>
  </building-types>
</freecol-specification>
