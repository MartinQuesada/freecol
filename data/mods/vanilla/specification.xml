<!-- Vanilla: New World luxury, export raw like silver (no processing chain). -->
<freecol-specification id="vanilla" version="0.2">
  <goods-types>
    <goods-type id="model.goods.vanilla" is-farmed="true"
                new-world-goods="true" production-weight="3.0">
      <market initial-amount="600" initial-price="14" price-difference="2"/>
    </goods-type>
  </goods-types>

  <resource-types>
    <resource-type id="model.resource.vanilla">
      <modifier id="model.goods.vanilla" index="10"
                type="multiplicative" value="2"/>
    </resource-type>
  </resource-types>

  <tile-types>
    <!-- Vanilla orchid: humid tropics (better in forest than open plains). -->
    <tile-type id="model.tile.tropicalForest" preserve="true">
      <production>
        <output goods-type="model.goods.vanilla" value="3"/>
      </production>
      <resource type="model.resource.vanilla" probability="45"/>
    </tile-type>
    <tile-type id="model.tile.savannah" preserve="true">
      <production>
        <output goods-type="model.goods.vanilla" value="2"/>
      </production>
      <resource type="model.resource.vanilla" probability="25"/>
    </tile-type>
    <tile-type id="model.tile.scrubForest" preserve="true">
      <production>
        <output goods-type="model.goods.vanilla" value="2"/>
      </production>
      <resource type="model.resource.vanilla" probability="20"/>
    </tile-type>
    <tile-type id="model.tile.rainForest" preserve="true">
      <production>
        <output goods-type="model.goods.vanilla" value="2"/>
      </production>
      <resource type="model.resource.vanilla" probability="35"/>
    </tile-type>
  </tile-types>

  <unit-types>
    <unit-type id="model.unit.expertVanillaPlanter" extends="colonist"
               skill="2" expert-production="model.goods.vanilla"
               score-value="5">
      <modifier id="model.goods.vanilla" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
    <!-- Native expert, only reachable with the conversos mod. -->
    <unit-type id="model.unit.nativeVanillaPlanter" extends="model.unit.indianConvert"
               expert-production="model.goods.vanilla" score-value="4"
               maximum-experience="0">
      <ability id="model.ability.nativeConvert" value="true"/>
      <modifier id="model.goods.vanilla" index="30"
                type="multiplicative" value="2"/>
    </unit-type>
  </unit-types>

  <unit-change-types>
    <unit-change-type id="model.unitChange.clearSkill" preserve="true">
      <unit-type-change id="model.unitChange.clearSkill.expertVanillaPlanter"
                        from="model.unit.expertVanillaPlanter"
                        to="model.unit.freeColonist" probability="100"/>
      <unit-type-change id="model.unitChange.clearSkill.nativeVanillaPlanter"
                        from="model.unit.nativeVanillaPlanter"
                        to="model.unit.indianConvert" probability="100"/>
    </unit-change-type>
    <unit-change-type id="model.unitChange.education" preserve="true">
      <unit-type-change id="model.unitChange.education.expertVanillaPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertVanillaPlanter"
                        probability="100" turns="6"/>
    </unit-change-type>
    <unit-change-type id="model.unitChange.experience" preserve="true">
      <unit-type-change id="model.unitChange.experience.expertVanillaPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertVanillaPlanter" probability="4"/>
      <unit-type-change id="model.unitChange.experience.nativeVanillaPlanter"
                        from="model.unit.indianConvert"
                        to="model.unit.nativeVanillaPlanter" probability="4">
        <scope ability-id="model.ability.upgradeConvert" ability-value="true"/>
      </unit-type-change>
    </unit-change-type>
    <unit-change-type id="model.unitChange.natives" preserve="true">
      <unit-type-change id="model.unitChange.natives.indenturedServant-expertVanillaPlanter"
                        from="model.unit.indenturedServant"
                        to="model.unit.expertVanillaPlanter" probability="100"/>
      <unit-type-change id="model.unitChange.natives.freeColonist-expertVanillaPlanter"
                        from="model.unit.freeColonist"
                        to="model.unit.expertVanillaPlanter" probability="100"/>
    </unit-change-type>
  </unit-change-types>

  <indian-nation-types>
    <indian-nation-type id="model.nationType.aztec" preserve="true">
      <skill id="model.unit.expertVanillaPlanter" probability="12"/>
    </indian-nation-type>
    <indian-nation-type id="model.nationType.arawak" preserve="true">
      <skill id="model.unit.expertVanillaPlanter" probability="8"/>
    </indian-nation-type>
  </indian-nation-types>
</freecol-specification>
